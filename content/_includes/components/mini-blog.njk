<article class="newspaper dropshadow content-box" style="text-align: center; position: relative;">
    <img class="image-dropshadow floating-image" src="images/page-assets/scrap/arizonastamp.png" alt=""
        style="object-fit: contain; width: 70px; margin-right: 1em; left: -30px; bottom: -35px; transform: rotate(10deg);">
    <img class="image-dropshadow floating-image" src="images/page-assets/scrap/philippinesstamp.png" alt=""
        style="object-fit: contain; width: 85px; margin-right: 1em; left: -40px; top: -20px; transform: rotate(-10deg);">
    <h2 class="blue-header">Mini Blog</h2>
    <div class="scrolling-contentbox padding" style="text-align: left;">
        {% set latestPost = collections.featured | reverse | first %}
        {% if latestPost.data.featured_image %}
        <a href="{{ latestPost.data.featured_image | stripSlash }}" target="_blank" rel="noopener noreferrer">
            <img id="featured_image" src="{{ latestPost.data.featured_image | stripSlash }}" alt="Cover for {{ latestPost.data.title }}"
                style="
                                                        float: right;
                                                    width: 80px;
                                                    border: 1px solid;
                                                    padding: 2px;
                                                    margin: 5px;                                              
                                                        ">
        </a>
        {% endif %}
        <h3 style="font-family: Glacier-Bold;">{{ latestPost.data.title }}</h3>
        <p>{{ latestPost.date | readableDate }}</p>
        <p>{{ latestPost.templateContent | excerpt }}</p>
        <hr style="margin-top: 10px; margin-bottom: 5px" />
        <p style="font-family: Glacier; text-align: center;">
            Read this post <a href="{{ latestPost.url | stripSlash }}">here</a>!
        </p>
    </div>
</article>